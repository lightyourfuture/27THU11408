% 康奈尔听课笔记模板（配色取自王道课件）
\documentclass[10.5pt,a4paper,oneside]{article}
\usepackage[a4paper,top=2.3cm,bottom=2.2cm,left=5.7cm,right=1.5cm,
  marginparwidth=4.25cm,marginparsep=0.55cm,headheight=14pt,footskip=1.1cm]{geometry}
\usepackage{xeCJK}
\usepackage{xeCJKfntef}
\xeCJKDeclareCharClass{FullLeft}{"201C,"2018}
\xeCJKDeclareCharClass{FullRight}{"201D,"2019}
\xeCJKDeclareCharClass{CJK}{"2460->"24FF,"2605,"2606}
\setmainfont{Noto Sans CJK SC}[BoldFont={Noto Sans CJK SC Bold},ItalicFont={Noto Sans CJK SC},ItalicFeatures={FakeSlant=0.18}]
\setsansfont{Noto Sans CJK SC}[BoldFont={Noto Sans CJK SC Bold}]
\setmonofont{DejaVu Sans Mono}[Scale=0.9]
\setCJKmainfont{Noto Sans CJK SC}[BoldFont={Noto Sans CJK SC Bold},ItalicFont={Noto Sans CJK SC},ItalicFeatures={FakeSlant=0.18}]
\setCJKsansfont{Noto Sans CJK SC}[BoldFont={Noto Sans CJK SC Bold}]
\setCJKmonofont{Noto Sans Mono CJK SC}[Scale=0.9]
\linespread{1.32}
\usepackage{amsmath,amssymb}
\usepackage[dvipsnames,table]{xcolor}
\usepackage{graphicx}
\usepackage{adjustbox}
\usepackage{tikz}
\usetikzlibrary{calc}
\usepackage[most]{tcolorbox}
\usepackage{eso-pic}
\usepackage{fancyhdr}
\usepackage{titlesec}
\usepackage{needspace}
\usepackage{enumitem}
\usepackage{xltabular,booktabs,array,colortbl}
\usepackage{marginnote}
\reversemarginpar
\renewcommand*{\raggedleftmarginnote}{}
\renewcommand*{\raggedrightmarginnote}{}
\usepackage{caption}
\usepackage{titletoc}
\usepackage{fancyvrb}
\usepackage{framed}
\usepackage[section]{placeins}
\usepackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=wdblue,urlcolor=wdblue,pdftitle={$title$},pdfauthor={听课笔记}}

% ---------- 课件配色 ----------
\definecolor{wdblue}{HTML}{4472C4}
\definecolor{wdlightblue}{HTML}{5B9BD5}
\definecolor{wdtitle}{HTML}{4A86C8}
\definecolor{wddark}{HTML}{1F3864}
\definecolor{wdorange}{HTML}{ED7D31}
\definecolor{wdgray}{HTML}{A5A5A5}
\definecolor{wdgold}{HTML}{FFC000}
\definecolor{wdgreen}{HTML}{70AD47}
\definecolor{wddeepgreen}{HTML}{3F7F2A}
\definecolor{wdred}{HTML}{C00000}
\definecolor{wdpurple}{HTML}{7030A0}
\definecolor{cuebg}{HTML}{F2F6FC}
\definecolor{codebg}{HTML}{F7F9FC}
\color[HTML]{262626}

% ---------- 行内样式 ----------
\newcommand{\hlred}[1]{\textcolor{wdred}{\bfseries #1}}
\newcommand{\hlblue}[1]{\textcolor{wdblue}{\bfseries #1}}
\newcommand{\hlgreen}[1]{\textcolor{wddeepgreen}{\bfseries #1}}
\newcommand{\hlorange}[1]{\textcolor{wdorange}{\bfseries #1}}
\newcommand{\hlpurple}[1]{\textcolor{wdpurple}{\bfseries #1}}
\newcommand{\uln}[1]{\CJKunderline[format=\color{wdred},thickness=0.9pt,depth=0.28em]{#1}}
\newcommand{\wavy}[1]{\CJKunderwave[format=\color{wdorange}]{#1}}
\newcommand{\hlmark}[1]{\CJKunderline[format=\color{wdgold!55},thickness=0.55em,depth=-0.05em]{#1}}
\newcommand{\tagbox}[2]{\tcbox[on line,colback=#1,colframe=#1,coltext=white,boxsep=0.5pt,left=3pt,right=3pt,top=0.5pt,bottom=0.5pt,arc=2pt,fontupper=\small\bfseries]{#2}}

% ---------- 康奈尔版式背景：左侧线索栏 ----------
\newlength{\cuestripw}\setlength{\cuestripw}{5.15cm}
\AddToShipoutPictureBG{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[cuebg] (current page.north west) rectangle ($$(current page.south west)+(\cuestripw,0)$$);
    \draw[wdblue,line width=1.2pt] ($$(current page.north west)+(\cuestripw,-1.55cm)$$) -- ($$(current page.south west)+(\cuestripw,1.55cm)$$);
    \node[anchor=west,text=wdblue,font=\small\bfseries] at ($$(current page.north west)+(0.75cm,-1.25cm)$$) {线索 · 问题};
    \node[anchor=west,text=wdblue,font=\small\bfseries] at ($$(current page.north west)+(\cuestripw+0.55cm,-1.25cm)$$) {笔记 · 老师主线 + 补充讲解};
  \end{tikzpicture}}

% ---------- 页眉页脚 ----------
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[R]{\small\color{wdgray}$chapter$}
\fancyfoot[C]{\small\color{wdgray}\thepage}
\fancyfoot[R]{\small\color{wdorange}$title$ · 听课笔记}
$if(toc)$\fancyfoot[L]{\small\hyperlink{toc}{\textcolor{wdblue}{\ensuremath{\uparrow}\,回到目录}}}$endif$
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\color{wdgray}\thepage}\fancyfoot[R]{\small\color{wdorange}$title$ · 听课笔记}}

% ---------- 标题：仿课件的蓝色标题 + 六色条 ----------
\newcommand{\sixbar}{\par\nointerlineskip\vspace{3pt}\centering
  \begin{tikzpicture}\foreach \c [count=\i] in {wdlightblue,wdorange,wdgray,wdgold,wdblue,wdgreen}
     {\fill[\c] ({(\i-1)*1.05},0) rectangle ({(\i-1)*1.05+0.92},0.11);}\end{tikzpicture}\par}
\titleformat{\section}[block]{\centering\Large\bfseries\color{wdtitle}}{}{0pt}{}[\sixbar]
\titlespacing*{\section}{0pt}{16pt}{10pt}
\pretocmd{\section}{\Needspace{8\baselineskip}}{}{}
\titleformat{\subsection}{\Needspace{7\baselineskip}\large\bfseries\color{wddark}}{\textcolor{wdblue}{\rule[-0.15em]{4pt}{1.05em}}\hspace{6pt}}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt}{5pt}
\titleformat{\subsubsection}{\Needspace{5\baselineskip}\normalsize\bfseries\color{wdblue}}{\textcolor{wdorange}{\large\ensuremath{\blacktriangleright}}\hspace{4pt}}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}\setlength{\parskip}{5pt}
\setlist{nosep,leftmargin=1.5em,itemsep=2pt}
\setlist[itemize,1]{label=\textcolor{wdblue}{\small\ensuremath{\bullet}}}
\setlist[itemize,2]{label=\textcolor{wdorange}{\scriptsize\ensuremath{\blacktriangleright}}}
\setlist[enumerate,1]{label=\textcolor{wdblue}{\bfseries\arabic*.}}
\providecommand{\tightlist}{\setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}}

% ---------- 目录 ----------
\setcounter{tocdepth}{$if(toc-depth)$$toc-depth$$else$2$endif$}
\titlecontents{section}[0pt]{\addvspace{5pt}\bfseries\color{wddark}}{}{}{\titlerule*[0.7pc]{\color{wdgray!60}.}\contentspage}
\titlecontents{subsection}[1.6em]{\addvspace{1pt}\small\color{black!75}}{}{}{\titlerule*[0.7pc]{\color{wdgray!40}.}\contentspage}
\newcommand{\tocback}{\par\vspace{-3pt}{\hfill\footnotesize\hyperlink{toc}{\textcolor{wdgray}{\ensuremath{\uparrow}\,回到目录}}}\par\vspace{-4pt}}

% ---------- 线索栏 ----------
\newcommand{\cueblock}[2]{\Needspace{4\baselineskip}\leavevmode#1{#2}\par\vspace{-\baselineskip}\vspace{-\parskip}}
% 线索直接贴在段首行的左侧（不用 marginnote，避免分页时偶尔落进正文栏）
\newcommand{\cuebox}[1]{\leavevmode\llap{\smash{\begin{minipage}[t]{\marginparwidth}\raggedright\small\linespread{1.18}\selectfont #1\end{minipage}}\hspace{\marginparsep}}}
\newcommand{\cuenote}[1]{\cuebox{{\color{wdblue}\bfseries Q\,}\color{wddark}#1}}
\newcommand{\cuekey}[1]{\cuebox{\color{wdred}\bfseries #1}}

% ---------- 讲解框 ----------
\tcbset{wdbox/.style={enhanced,breakable,arc=2pt,boxrule=0pt,leftrule=3pt,left=7pt,right=7pt,top=5pt,bottom=5pt,
   before skip=7pt,after skip=7pt,fonttitle=\bfseries\small,attach title to upper={\quad},coltitle=#1,
   colframe=#1,colback=#1!6}}
\newtcolorbox{defbox}[1][]{enhanced,breakable,arc=3pt,boxrule=0.8pt,colframe=wdblue,colback=wdblue!4,
   left=8pt,right=8pt,top=6pt,bottom=6pt,fonttitle=\bfseries\small,coltitle=white,colbacktitle=wdblue,
   title={定义#1},before skip=8pt,after skip=8pt}
\newtcolorbox{bridgebox}{wdbox=wdblue,title={承上启下}}
\newtcolorbox{plainbox}{wdbox=wddeepgreen,colframe=wdgreen,colback=wdgreen!8,title={大白话}}
\newtcolorbox{deepbox}{wdbox=wdpurple,title={背后的思想}}
\newtcolorbox{exambox}{wdbox=wdred,title={考点}}
\newtcolorbox{pitfallbox}{wdbox=wdorange,title={易错提醒}}
\newtcolorbox{bookbox}{wdbox=wddark,colback=wdgray!10,colframe=wdgray,title={王道书补充}}
\newtcolorbox{teacherbox}{wdbox=wdorange,colback=wdgold!8,colframe=wdgold,coltitle=wdorange,title={老师原话}}
\newtcolorbox{fixbox}{wdbox=wdred,colback=wdred!4,title={勘误 / 说明}}
% 习题笔记用
\newtcolorbox{questionbox}[1][]{enhanced,breakable,arc=3pt,boxrule=0.8pt,colframe=wddark,colback=white,
   left=8pt,right=8pt,top=6pt,bottom=6pt,fonttitle=\bfseries\small,coltitle=white,colbacktitle=wddark,
   title={#1},before skip=10pt,after skip=6pt}
\newtcolorbox{videobox}{wdbox=wdorange,colback=wdgold!8,colframe=wdgold,coltitle=wdorange,title={视频讲解}}
\newtcolorbox{jiexibox}{wdbox=wddark,colback=wdgray!10,colframe=wdgray,title={书上解析}}
\newtcolorbox{addbox}{wdbox=wdpurple,title={我的补充}}
\newtcolorbox{recallbox}{wdbox=wdblue,title={回顾正课}}
\newtcolorbox{watchbox}{enhanced,breakable,arc=3pt,boxrule=1pt,colframe=wdorange,colback=wdgold!12,
   fonttitle=\bfseries\small,coltitle=white,colbacktitle=wdorange,title={建议去看视频},left=8pt,right=8pt,before skip=8pt,after skip=8pt}
\newtcolorbox{summarybox}{enhanced,arc=3pt,
   boxrule=1pt,colframe=wdblue,colback=white,colbacktitle=wdblue,coltitle=white,fonttitle=\bfseries,
   title={总结区 · 用自己的话复述这一节},left=10pt,right=10pt,top=8pt,bottom=8pt,before skip=14pt}

% ---------- 代码 ----------
$highlighting-macros$
\makeatletter
\@ifundefined{Shaded}{}{\renewenvironment{Shaded}{\def\FrameCommand{\fboxsep=5pt\fboxrule=0.5pt\fcolorbox{wdblue!35}{codebg}}%
   \MakeFramed{\advance\hsize-\width\FrameRestore}\small}{\endMakeFramed}}
\makeatother
\fvset{fontsize=\small}

% ---------- 表格 ----------
\renewcommand{\arraystretch}{1.42}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

% ---------- 图片 ----------
% 课件截图做成浮动体：LaTeX 会自动用正文填满页面，避免大块空白
\setcounter{topnumber}{3}\setcounter{bottomnumber}{2}\setcounter{totalnumber}{4}
\renewcommand{\topfraction}{0.85}\renewcommand{\bottomfraction}{0.6}\renewcommand{\textfraction}{0.12}\renewcommand{\floatpagefraction}{0.75}
\setlength{\textfloatsep}{10pt plus 3pt minus 2pt}\setlength{\floatsep}{8pt plus 2pt}
\newcommand{\slidefig}[3]{\begin{figure}[!ht]\centering\begin{tcolorbox}[enhanced,width=#2\linewidth,arc=2pt,boxrule=0.6pt,colframe=wdgray!70,
   colback=white,left=2pt,right=2pt,top=2pt,bottom=2pt,drop fuzzy shadow=black!25]\includegraphics[width=\linewidth]{#1}\end{tcolorbox}
   \vspace{-3pt}{\small\color{wdgray}#3}\end{figure}}
\newcommand{\plainfig}[3]{\par\noindent\begin{minipage}{\linewidth}\centering\includegraphics[width=#2\linewidth]{#1}\par\vspace{2pt}{\small\color{wdgray}#3}\end{minipage}\par\vspace{4pt}}

\begin{document}
% ---------- 封面条（仿课件封面） ----------
\thispagestyle{plain}
\begin{tcolorbox}[enhanced,enlarge left by=-4.8cm,width=\linewidth+4.8cm,arc=0pt,boxrule=0pt,
   colback=wddark,interior style={left color=wddark,right color=wdblue},left=18pt,right=18pt,top=14pt,bottom=12pt,
   overlay={\draw[white,line width=2.5pt] ([xshift=10pt,yshift=-10pt]frame.north west) -- ++(0,-0.9cm);
            \draw[white,line width=2.5pt] ([xshift=10pt,yshift=-10pt]frame.north west) -- ++(1.6cm,0);
            \draw[white,line width=2.5pt] ([xshift=-10pt,yshift=10pt]frame.south east) -- ++(0,0.9cm);
            \draw[white,line width=2.5pt] ([xshift=-10pt,yshift=10pt]frame.south east) -- ++(-1.6cm,0);}]
  {\color{white!85!wdlightblue}\small 数据结构 · $chapter$ · 康奈尔听课笔记}\par\vspace{6pt}
  {\color{white}\fontsize{22}{28}\selectfont\bfseries $title$}\par\vspace{6pt}
  {\color{white!80!wdlightblue}\small $subtitle$}
\end{tcolorbox}
\vspace{4pt}
$if(toc)$
\begin{tcolorbox}[enhanced,arc=3pt,boxrule=0.8pt,colframe=wdblue,colback=wdblue!3,left=10pt,right=10pt,top=6pt,bottom=6pt,
   colbacktitle=wdblue,coltitle=white,fonttitle=\bfseries\small,title={目录 · 点击标题跳转}]
\hypertarget{toc}{}\makeatletter\@starttoc{toc}\makeatother
\end{tcolorbox}
$endif$
$body$
\end{document}
